# TriageFox self-host settings. deploy/setup.sh creates deploy/.env from this file and fills in every
# generated secret. deploy/.env is git-ignored. Never paste its contents into chat, issues or tickets.

# ===== Where TriageFox lives =====
# SITE_ADDRESS: your domain (Caddy gets a free HTTPS certificate for it) or "localhost" for a trial.
# APP_URL: the address people type, including https://
SITE_ADDRESS=
APP_URL=
APP_MODE=selfhost
# Ports Caddy listens on (change only if 80/443 are taken, e.g. for a trial on a laptop).
HTTP_PORT=80
HTTPS_PORT=443

# Ready-made images instead of building from source (set by setup.sh when you pass WORKER_IMAGE and WEB_IMAGE):
#   WEB_IMAGE=ghcr.io/kartik01a/triagefox-web:v1.0.0
#   WORKER_IMAGE=ghcr.io/kartik01a/triagefox-worker:v1.0.0
#   TRIAGEFOX_PULL=always
WEB_IMAGE=
WORKER_IMAGE=
TRIAGEFOX_PULL=build

# ===== Generated by setup.sh (leave as they are) =====
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
CRYPTO_CURRENT_VERSION=
CRYPTO_PUBLIC_KEYS=
# WORKER ONLY. If you lose this, every stored Trello/Jira token becomes unreadable (people must reconnect).
# Keep a copy somewhere safe, apart from your database backups.
CRYPTO_PRIVATE_KEYS=

# ===== Email (needed: sign-up and invitation emails) =====
# For a trial run `docker compose --profile trial up -d` and use SMTP_HOST=mailpit, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="TriageFox <hello@example.com>"

# ===== AI =====
# Your OpenAI key. Alternatively leave it empty and let each workspace enter its own under "AI key".
OPENAI_API_KEY=
# Models are server settings; people who bring a key never choose models.
AI_MODEL_DEFAULT=gpt-6-luna
AI_MODEL_ESCALATION=gpt-6.1-sol
AI_MODEL_EMBEDDING=text-embedding-3-small
# Speech to text for customers' voice messages
AI_MODEL_TRANSCRIBE=gpt-transcribe

# ===== Your own developer apps (see docs/self-hosting.md and docs/setup/providers.md) =====
# Crisp plugin: token identifier + key, the plugin's own id, and the hook signing secret.
CRISP_PLUGIN_ID=
CRISP_PLUGIN_KEY=
CRISP_PLUGIN_UUID=
CRISP_HOOK_SECRET=
# Trello Power-Up API key (public) and/or Atlassian OAuth app. Leave blank to turn a tool off.
TRELLO_API_KEY=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Where urgent alerts go (the worker emails them; Slack is optional): a job that kept failing, a rejected OpenAI key.
ALERT_EMAIL=
SLACK_ALERTS_WEBHOOK_URL=

# ===== Optional =====
# Let anyone sign up. Default (false): the first account is open, everyone else needs an invitation.
SELFHOST_OPEN_SIGNUP=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=
