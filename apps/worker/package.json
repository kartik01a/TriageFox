{
  "name": "@triagefox/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "^11.9.0",
    "@triagefox/ai": "workspace:*",
    "@triagefox/crypto": "workspace:*",
    "@triagefox/db": "workspace:*",
    "@triagefox/shared": "workspace:*",
    "bullmq": "^6.4.2",
    "ioredis": "^6.0.0",
    "@triagefox/connectors": "workspace:*",
    "@triagefox/rpc": "workspace:*",
    "@triagefox/pipeline": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
