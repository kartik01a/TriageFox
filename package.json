{
  "name": "triagefox",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose -f deploy/compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f deploy/compose.dev.yml down",
    "infra:reset": "docker compose -f deploy/compose.dev.yml down -v && pnpm infra:up",
    "db:generate": "pnpm --filter @triagefox/db generate",
    "db:migrate": "pnpm --filter @triagefox/db migrate",
    "db:seed": "pnpm --filter @triagefox/db seed",
    "keys:generate": "node scripts/generate-keys.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0"
  }
}
