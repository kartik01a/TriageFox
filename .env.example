# Copy to .env and fill in. .env is git-ignored. Never paste these values into chat.
# `pnpm keys:generate` fills in the generated secrets below and any missing local defaults.

# ===== App (Phase 1) =====
NODE_ENV=development
APP_MODE=hosted                 # hosted | selfhost
APP_URL=http://localhost:3000

# Local dev database (docker compose, see deploy/compose.dev.yml). Runtime uses the restricted role.
DATABASE_URL=postgres://triagefox_app:triagefox_dev_app@localhost:54320/triagefox
# Owner role, used ONLY by migrations (bypasses row-level security).
DATABASE_MIGRATION_URL=postgres://triagefox:triagefox_dev_owner@localhost:54320/triagefox
REDIS_URL=redis://:triagefox_dev_redis@localhost:63790

# Generated by `pnpm keys:generate` (leave empty to have it generated)
BETTER_AUTH_SECRET=
# Sealed-box keys (docs/security.md §3). The web app gets PUBLIC keys only.
CRYPTO_CURRENT_VERSION=
CRYPTO_PUBLIC_KEYS=
# WORKER ONLY. In production this must never be set on the web container.
CRYPTO_PRIVATE_KEYS=

# Email: Mailpit locally (UI at http://localhost:8025). Resend SMTP (or any SMTP) in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="TriageFox <hello@triagefox.local>"

# AI models are server configuration (customers bring a key, never choose models)
AI_MODEL_DEFAULT=gpt-6-luna
AI_MODEL_ESCALATION=gpt-6.1-sol
AI_MODEL_EMBEDDING=text-embedding-3-small

# ===== Integrations (Phase 2). Leave blank to disable a provider in the UI. =====
# Trello Power-Up API key (public identifier). Add APP_URL as an allowed origin on the key.
TRELLO_API_KEY=
# Atlassian OAuth 2.0 (3LO) app. Callback URL to register: <APP_URL>/api/connections/jira/callback
ATLASSIAN_CLIENT_ID=
# Worker only (never on the web container):
ATLASSIAN_CLIENT_SECRET=
# Crisp plugin. CRISP_PLUGIN_ID/KEY are the TOKEN identifier/key (Marketplace → plugin → Tokens);
# CRISP_PLUGIN_UUID is the plugin's own id shown at the top of the plugin page. Worker only.
CRISP_PLUGIN_ID=
CRISP_PLUGIN_KEY=
CRISP_PLUGIN_UUID=
# Crisp plugin hook signing secret (Marketplace → plugin → Web Hooks). Used by the WEB app to verify incoming hooks.
CRISP_HOOK_SECRET=

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=
# Crisp website id of the "TriageFox Support" workspace: shows the support chat widget
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ===== Phase 0 spike variables (only the throwaway scripts in spikes/ use these) =====
# The spikes also read TRELLO_API_KEY, ATLASSIAN_CLIENT_ID/SECRET and CRISP_PLUGIN_ID/KEY from above.
OPENAI_API_KEY=
# Produced by `pnpm trello:url` -> approve -> copy the token shown
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_LIST_ID=
JIRA_PROJECT_KEY=
# The "TriageFox Dev" website/session ids (the spikes also read CRISP_HOOK_SECRET from above)
CRISP_WEBSITE_ID=
CRISP_SESSION_ID=
