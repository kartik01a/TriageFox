# Copy to .env and fill in. .env is git-ignored. Never paste these values into chat.
# Phase 0 spike variables (spikes/). Later phases add more.

# --- OpenAI (spikes/openai) ---
OPENAI_API_KEY=

# --- Trello (spikes/trello) ---
# Get the key at https://trello.com/power-ups/admin (create a Power-Up, then "API key")
TRELLO_API_KEY=
# Produced by `pnpm trello:url` -> approve -> copy the token shown
TRELLO_TOKEN=
# Test board/list ids are printed by the probe; paste them back here
TRELLO_BOARD_ID=
TRELLO_LIST_ID=

# --- Jira (spikes/jira) ---
# Atlassian developer console -> create an OAuth 2.0 (3LO) app; callback http://localhost:3000/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# The probe saves tokens to spikes/.tokens.json (git-ignored)
JIRA_PROJECT_KEY=

# --- Crisp (spikes/crisp) ---
# Marketplace developer account -> create a plugin -> development token
CRISP_PLUGIN_ID=
CRISP_PLUGIN_KEY=
# Signature secret from the plugin's hook settings
CRISP_HOOK_SECRET=
# The "TriageFox Dev" website id
CRISP_WEBSITE_ID=
CRISP_SESSION_ID=
